# EtsyToolshed 本地环境变量示例
# 复制为 .env.local 后填入真实值（.env.local 已在 .gitignore 中，不会提交）

# ---------- Supabase ----------
# 在 Supabase Dashboard → Project Settings → API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 服务端使用，仅在服务端代码中读取，绝不下发前端
# 在 Supabase Dashboard → Project Settings → API → service_role 获取
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- AI（P1 规则版不使用；P4 接 Pro 后启用） ----------
# Anthropic Claude 或 DeepSeek，二选一
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
AI_PROVIDER=anthropic

# ---------- Lemon Squeezy（P4） ----------
# 需人工在 Lemon Squeezy 后台创建：
#   1. Store → 拿到 LEMON_SQUEEZY_STORE_ID
#   2. 两个产品/variant：Starter($9/mo)、Pro($19/mo) → 拿到 variant ID
#   3. Settings → API → 生成 LEMON_SQUEEZY_API_KEY
#   4. Settings → Webhooks → 添加 https://你的域名/api/ls/webhook，
#      勾选 subscription_* 事件 → 生成 LEMON_SQUEEZY_WEBHOOK_SECRET
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_STARTER_VARIANT_ID=
LEMON_SQUEEZY_PRO_VARIANT_ID=

# ---------- 站点 ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- 费率同步（Vercel Cron） ----------
# Vercel Cron 会带 Authorization: Bearer <CRON_SECRET> 调用 /api/fees/sync
# 在 Vercel 项目 Settings → Environment Variables 中设置，任意随机长字符串
CRON_SECRET=

# 费率页 / 政策页变化时的告警 webhook（Discord/Slack/飞书等，接收 JSON {text}）
# 费率同步与政策同步共用此 webhook；不填则只写日志，不发告警
FEES_ALERT_WEBHOOK_URL=
